# Plantilla de variables de entorno. Copiar a `.env.local` para desarrollo local.
# No versionar `.env.local`. Los valores remotos se cargan en Vercel o GitHub
# Actions, nunca en este archivo.

# --- Local: Supabase CLI (pnpm db:start) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
LOCAL_DEV_USERS_PASSWORD=

# --- Preview y Staging: Supabase Cloud digraf-staging ---
# Las variables remotas se definen en el proyecto Vercel `digraf-staging` y
# nunca se versionan. Documentar solo el nombre, la sensibilidad y el alcance.

# Publicadas al cliente (NEXT_PUBLIC_*). Requieren redeploy ante cambios.
#   NEXT_PUBLIC_SUPABASE_URL                -- URL estable de Supabase staging
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY    -- clave pública, segura para el navegador

# Solo servidor. No exponer al cliente ni versionar.
#   SUPABASE_URL                            -- mismo valor que NEXT_PUBLIC_SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY               -- sensible, server-only, sin prefijo NEXT_PUBLIC_

# Los secretos de migración (Supabase access token, project ref, db password)
# viven en el GitHub Environment `staging`, no en Vercel ni en este archivo.
